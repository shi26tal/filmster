
<nav class="w-full border border-gray-200 rounded">
  <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
    <%# logo %>
    <h1 class="text-3xl text-[#337ab7] tracking-wider">
      <a href="/">Filmster</a>
    </h1>

    <div class="flex items-center text-sm gap-8 text-gray-500">
        <% if current_user %>
            <%= link_to "Profile", user_path(current_user), class: "hover:text-[#337ab7]" %>
            <%= button_to "Log Out", logout_path, method: :delete, class: "hover:text-[#337ab7] cursor-pointer" %>
        <% else %>
            <%= link_to "Sign Up", signup_path, class: "hover:text-[#337ab7]" %>
            <%= link_to "Log In", login_path, class: "hover:text-[#337ab7]" %>
        <% end %>
        <a href="#" class="hover:text-[#337ab7]">My Websites</a>
    </div>

  </div>
</nav>
