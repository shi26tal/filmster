
<div class="flex flex-col items-center">
  <%# title  %>
  <div class="mt-5 mb-2.5">
    <h1 class="text-4xl font-bold">
      <%= @movie[:title]%>
    </h1>

  </div>

  <%# genre %>
  <div>
    <% @movie[:genres].each do |genre|, class: "flex gap-2 bg-[#777777] text-white" %>
      <span>
        <%= genre %>

      </span>
    
    <% end %>
  </div>

</div>

