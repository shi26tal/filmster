
<%# top section %>
<div class="flex flex-col items-center mb-5">
  <%# title  %>
  <div class="mt-5 mb-2.5">
    <h1 class="text-4xl font-bold">
      <%= @movie[:title]%>
    </h1>

  </div>

  <%# genre %>
  <div class="flex gap-2 mb-5">
    <% @movie[:genres].each do |genre| %>
      <span class="bg-[#777777] text-white px-2 py-1 rounded-md">
        <%= genre %>
      </span>
    <% end %>
  </div>

  <%# poster %>
  <div>
    <%= image_tag @movie[:poster] ,class: "w-64 object-cover"%>
  </div>
</div>

<%# lower section %>

<div class="grid grid-cols-12 gap-6 border border-[#ddd] rounded-md p-4">

  <%# description %>
  <div class="md:col-span-6 md:p-7.5 p-4">
    
      <p class="mb-3">
        <%= @movie[:description]%>
      </p>

     <div class="space-y-3 text-gray-700">

      <p>
        <span class="font-semibold">Duration:</span>
        <%= @movie[:duration] %>
      </p>

      <p>
        <span class="font-semibold">Released Date:</span>
        <%= @movie[:released_date] %>
      </p>

      <p>
        <span class="font-semibold">Popularity:</span>
        <%= @movie[:popularity] %>
      </p>

    </div>

    

  </div>

  <%# right side - review %>
  <div class="md:col-span-6 p-4">

    <h2 class="text-3xl mb-4">
      Reviews
    </h2>

    <div class="border-y border-gray-200 py-4 px-4 flex justify-between items-center mb-5">

      <span>1</span>
      <h3 class="text-[#337ab7] hover:underline hover:text-[#1a4871]">
        suvek
      </h3>

      <p>
        wow
      </p>
    </div>
  </div>

</div>

