<%# TMDB returns hashes with string keys %>

<div class="min-h-screen bg-white grid grid-cols-1 md:grid-cols-12 gap-6">
  <%# find movies and review%>
  <div class="md:col-span-5 px-3.5">
    <div class="pb-5 mb-5 border-b border-[#eeeeee]">
      <h4 class="mt-5 mb-2.5 text-4xl">Find Movies</h4>
      <%= form_with url: root_path, method: :get do |f| %>
      <div class="flex gap-6 items-center">
        <%# hamiley input text lekheko query url ma janxa %> 
        <%= f.text_field :query, placeholder: "Enter Movie Name", class: "border border-[#ccc]
        rounded-md text-[#555555] px-3 py-1.5 w-full" %> 
        <%= f.button "Search", class: "bg-[#5cb85c] text-white border border-[#4cae4c] flex
        items-center gap-2 rounded-md px-3 py-2" %>
      </div>
      <% end %> 
     
    </div>

    <div>
      <div class="pb-5 mb-5 border-b border-[#eeeeee]">
        <h6 class="text-2xl">Latest Reviews</h6>
      </div>

      <% @reviews.each do |review| %>

        <div class="mb-5 pb-5 border-b border-[#eeeeee]">
          <p class="text-[#555555] mb-3"><%= review.content %></p>

          <div class="text-sm text-[#777777]">
            <%= link_to review.user.name, user_path(review.user), class: "text-[#337ab7] hover:underline hover:text-[#1a4871]" %>
            |
            <%= link_to review.movie.title, movie_path(review.movie.tmdb_id), class: "text-[#337ab7] hover:underline hover:text-[#1a4871]" %>
          </div>
        </div>

      <% end %>
    </div>

  </div>

  <%# movies %>

   <%# id : PostgreSQL primary key %>
    <%# tmdb_id : the movie's original ID from TMDB %>

  <div class="md:col-span-7 px-3.5">
    <div class="<%= params[:query].present? ? 'flex flex-col gap-6' : 'grid grid-cols-2 md:grid-cols-3 gap-4' %>" >
      <% @movies.each do |movie| %> 
        <% if params[:query].present? %> 
        <%# MoviesController currently expects the TMDB ID in the URL, so we must pass movie.tmdb_id %>
          <%= link_to movie_path(movie.tmdb_id) do %>
            <div class="flex gap-4 border-b border-gray-200 pb-5">
              <div class="w-1/2 shrink-0">
                <%= image_tag "https://image.tmdb.org/t/p/w500#{movie.poster_path}", class: "w-full object-cover rounded" %>
              </div>

              <div class="flex-1 min-w-0">
                <h3 class="text-lg font-bold mb-2"><%= movie.title %></h3>

                <p class="text-sm text-gray-600 leading-relaxed">
                  <%= movie.overview %>
                </p>
              </div>
            </div>
          <% end %>

        <% else %> 

       

          <%= link_to movie_path(movie.tmdb_id) do %>
            <div class="relative overflow-hidden">
              <%= image_tag "https://image.tmdb.org/t/p/w500#{movie.poster_path}", class: "w-full object-cover" %>
              <div class="absolute bottom-0 w-full bg-black/30 text-white text-center font-bold p-2" >
                <%= movie.title %>
              </div>
            </div>
          <% end %>

        <% end %> 
      <% end %>
    </div>
  </div>
</div>


<%# pahiley @movies contained TMDB Hashes so you accessed values using movie["title"].  %>
<%#  Now search results are Active Record Movie objects so you access values using movie.title.  %>




